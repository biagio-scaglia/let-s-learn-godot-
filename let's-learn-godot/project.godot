; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Erbalta"
config/description="Un piccolo RPG in pixel art: Subaru ed Emilia, un villaggio che ricomincia ogni alba e qualcosa nel bosco che guarda."
config/version="1.1"
run/main_scene="res://ui/opening_movie.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon/icon.png"
config/windows_native_icon="res://assets/icon/icon.ico"

[autoload]

Settings="*res://core/settings.gd"
Progress="*res://core/progress.gd"
Sfx="*res://core/sfx.gd"
Stats="*res://core/stats.gd"
Inventory="*res://core/inventory.gd"
SaveSystem="*res://core/save_system.gd"
Dialogue="*res://ui/dialogue_box.tscn"
Fade="*res://ui/fade.tscn"
Game="*res://core/game.gd"
Pause="*res://ui/pause_menu.tscn"
ReturnByDeath="*res://ui/return_by_death.tscn"
Hud="*res://ui/hud.tscn"
InventoryMenu="*res://ui/inventory_menu.tscn"
Battle="*res://ui/battle.tscn"
Farewell="*res://ui/farewell.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
BeehaveGlobalMetrics="*res://addons/beehave/metrics/beehave_global_metrics.gd"
BeehaveGlobalDebugger="*res://addons/beehave/debug/global_debugger.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/per_pixel_transparency/allowed=true

[editor_plugins]

enabled=PackedStringArray("res://addons/beehave/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/gdUnit4/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

[gui]

theme/custom="res://ui/theme.tres"

