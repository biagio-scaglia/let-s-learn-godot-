lines = PackedStringArray("Subaru! Eccoti, finalmente.", "Questo villaggio è così tranquillo... Il Saggio dice che qui gli alberi crescono più felici.", "Hai già conosciuto Lina? Abita nella casa col tetto rosso, a nord-ovest.")
repeat_lines = PackedStringArray("Se ti stanchi, riposiamo un po' qui in piazza. Non c'è nessuna fretta, no?")
